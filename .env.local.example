NODE_ENV="development"
APP_URL="http://localhost:3000"

# Option A: local Docker Postgres (recommended for production-like local testing)
DATABASE_URL="postgresql://msap_app:msap_local_password@localhost:5432/msap_freshers"
REQUIRE_DATABASE="true"
DB_CONNECTION_LIMIT="5"

# Option B: to use JSON-only local development instead, comment DATABASE_URL
# and change REQUIRE_DATABASE=false. Never use JSON storage on Vercel.

JWT_SECRET="local-development-secret-change-before-production-1234567890"
SESSION_SECRET="local-session-secret-change-before-production-1234567890"
ADMIN_DEFAULT_EMAIL="admin@msap.org"
ADMIN_DEFAULT_PASSWORD="admin123"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_UPI_ID=""
