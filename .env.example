# ==============================================================================
# MSAP 53rd Freshers' Meet 2026 — environment template
# Production DB recommendation: Neon Postgres through Vercel Marketplace
# ==============================================================================

NODE_ENV="production"
APP_URL="https://your-project.vercel.app"

# DATABASE ---------------------------------------------------------------------
# Preferred: DATABASE_URL injected by Neon/Vercel Marketplace.
# Use the POOLED Neon connection URL for serverless production where offered.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Compatibility fallbacks only. DATABASE_URL has first priority.
POSTGRES_URL=""
NETLIFY_DATABASE_URL=""

REQUIRE_DATABASE="true"
DB_CONNECTION_LIMIT="3"
DB_CONNECTION_TIMEOUT_MS="10000"
DB_IDLE_TIMEOUT_MS="10000"

# SECURITY ---------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
SESSION_SECRET="replace-with-another-long-random-secret"

# RAZORPAY ---------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"
PAYMENT_UPI_ID="your-verified-vpa@bank"

# EVENT ------------------------------------------------------------------------
EVENT_TICKET_PRICE="350"
EVENT_TIME="5:30 PM Sharp"
EVENT_VENUE="Pune (MSAP Campus Main Auditorium)"

# ADMIN BOOTSTRAP --------------------------------------------------------------
ADMIN_DEFAULT_EMAIL="admin@msap.org"
ADMIN_DEFAULT_PASSWORD="replace-with-a-strong-password"

# OPTIONAL EMAIL ---------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
