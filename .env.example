# ==============================================================================
# MSAP 53rd Freshers' Meet 2026 Ticketing System — Production Environment Config
# ==============================================================================

# Node Runtime Environment ('production' enforces strict MySQL-only and signature verification)
NODE_ENV="production"
PORT=3000

# Base Application Host URL (used for pass links and QR ticket redirection)
APP_URL="https://myfrehers.netlify.app/"

# MySQL Production Database (Strict Single Source of Truth)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="msap_freshers_2026"
DB_USER="msap_user"
DB_PASSWORD="your_strong_mysql_password"
DB_CONNECTION_LIMIT="30"
REQUIRE_MYSQL="true"

# Security Tokens & Secrets
JWT_SECRET="1de8ab4dd8723667b51623d592bf9aabd8027cebb54913c3798055017270c69283791dd37e5428e2cda2e5bfe3b829ed"
SESSION_SECRET="generate_a_secondary_secure_session_secret"
GOOGLE_FORM_WEBHOOK_SECRET="msap_google_sheets_secret_token_2026"
WEBHOOK_SECRET="msap_google_sheets_secret_token_2026"

# Payment Gateway Configuration (Razorpay)
# Key ID & Key Secret from the Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_live_TfUKXGP5vi9tov"
RAZORPAY_KEY_SECRET="kFllcwgQIvA1PDZQfHD924Ua"
# Webhook signing secret, set on the same value in the Razorpay Dashboard webhook config
RAZORPAY_WEBHOOK_SECRET="https://myfresher.netlify.app/api/payment/webhook"
# Optional: only set this to the organizer's verified VPA; the static QR remains the payment-page asset.
PAYMENT_UPI_ID="leemaxoinam068@oksbi"

# Server-Authoritative Ticket Price in INR (Frontend amount is NEVER trusted)
EVENT_TICKET_PRICE=350
EVENT_TIME="5:30 PM Sharp"
EVENT_VENUE="Pune (MSAP Campus Main Auditorium)"

# Default Seed Administrator Credentials (only used if no admin exists in MySQL)
ADMIN_DEFAULT_EMAIL="admin@msap.org"
ADMIN_DEFAULT_PASSWORD="ChangeMe@MSAP2026"

# Automated Email Delivery (Optional: Resend, SendGrid, or SMTP)
EMAIL_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
